# Copie para .env e ajuste. O .env nunca vai para o git.

# Django
SECRET_KEY=troque-isto-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Em produção: as origens que o Nginx atende, com esquema.
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Banco — o backend em container fala com o host "db" na porta 5432;
# rodando `make run` nativo, é localhost na porta publicada abaixo.
DATABASE_URL=postgres://ppg:ppg@localhost:5433/ppg

# Porta que o Postgres do projeto ocupa NO HOST. 5433 e não 5432 porque
# esta máquina já tem outro Postgres na 5432.
DB_HOST_PORT=5433

# Credenciais usadas pelo container do Postgres (docker-compose)
POSTGRES_DB=ppg
POSTGRES_USER=ppg
POSTGRES_PASSWORD=ppg

# -----------------------------------------------------------------------------
# Esteira de obra (worktrees paralelas)
#
# Toda chave do .env.worktree precisa estar documentada aqui — é a regra que
# mantém um lugar só para descobrir o que existe. Os valores abaixo são os do
# CHECKOUT PRINCIPAL, isto é, offset 0; numa worktree o montar-canteiro.sh
# remove estas linhas e reescreve cada uma com a porta deslocada.
# -----------------------------------------------------------------------------

# Nome do projeto Compose. No checkout principal repete o `name:` do
# docker-compose.yml; numa worktree vira <projeto>-<plano>.
COMPOSE_PROJECT_NAME=simple_ppg_manager

# Deslocamento de portas do canteiro. 0 aqui, por definição: o checkout
# principal é a origem da faixa. Só o montar-canteiro.sh lê esta variável.
HELTON_OFFSET=0

# Porta do Postgres no host. Mesmo valor de DB_HOST_PORT acima — DB_PORT vence
# quando os dois existem, e é o nome que a esteira escreve.
DB_PORT=5433

# Porta em que o Nginx atende. É por ela que se abre a aplicação; nunca a 5173
# do Vite direto (ver ADR-004).
NGINX_PORT=8080
