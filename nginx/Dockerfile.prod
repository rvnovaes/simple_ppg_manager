# Imagem de PRODUÇÃO do Nginx: o build estático do SvelteKit mais a
# configuração de origem única. É o que substitui o serviço `frontend` (Vite)
# do desenvolvimento — em produção não há processo Node (ADR-005): o Node só
# existe no primeiro estágio, para o `npm run build`, e fica para trás.
#
# O contexto de build é a RAIZ do repositório (precisa de frontend/ e nginx/);
# o .dockerignore da raiz deixa passar só esses dois diretórios.

# --- 1. build do front -------------------------------------------------------
# `-slim` (glibc), pelo mesmo motivo do docker-compose.yml: os binários do
# rollup e do @tailwindcss/oxide no package-lock são linux-x64-gnu.
FROM node:25-slim AS front
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- 2. nginx ----------------------------------------------------------------
FROM nginx:alpine
COPY nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY nginx/proxy_headers.prod.conf /etc/nginx/proxy_headers.conf
COPY --from=front /app/build /srv/front
