# Copie para .env e ajuste. O .env nunca vai para o git.

# Django
SECRET_KEY=troque-isto-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Em produção: as origens que o Nginx atende, com esquema.
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Banco — o backend em container fala com o host "db" na porta 5432;
# rodando `make run` nativo, é localhost na porta publicada abaixo.
DATABASE_URL=postgres://ppg:ppg@localhost:5433/ppg

# Porta que o Postgres do projeto ocupa NO HOST. 5433 e não 5432 porque
# esta máquina já tem outro Postgres na 5432.
DB_HOST_PORT=5433

# Credenciais usadas pelo container do Postgres (docker-compose)
POSTGRES_DB=ppg
POSTGRES_USER=ppg
POSTGRES_PASSWORD=ppg
