# Imagem de PRODUÇÃO do backend: gunicorn servindo o WSGI do Django, sem
# dependências de desenvolvimento e sem o código montado por volume.
# A de desenvolvimento é o `Dockerfile` ao lado (runserver com reload).
#
# Construída pelo job `construir` do .gitlab-ci.yml e publicada no registry
# do GitLab; o servidor só faz pull (ver docs/adr/011).
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PATH=/opt/venv/bin:$PATH \
    DJANGO_SETTINGS_MODULE=config.settings.prod

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# `--frozen`: instala exatamente o uv.lock versionado, sem tentar resolver de
# novo. `--no-dev`: pytest, ruff e mypy não vão para produção.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .

# Sem root em runtime (com home: o gunicorn guarda nele o socket de
# controle). O uid fixo (1000) é o dono de static_root/ e media/,
# que em produção são volumes: o Docker copia a permissão do diretório da
# imagem para o volume vazio na primeira montagem.
RUN useradd --uid 1000 --create-home django \
    && mkdir -p static_root media \
    && chown django:django static_root media
USER django

EXPOSE 8000

# Três workers síncronos bastam para a carga de uma instituição (ADR-001).
# O timeout de 120s cobre a geração de PDF (ata, resultado de bolsas), que é
# feita dentro do request.
CMD ["gunicorn", "config.wsgi:application", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "3", \
     "--timeout", "120", \
     "--access-logfile", "-"]
