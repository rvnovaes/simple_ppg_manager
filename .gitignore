# =============================================================================
# PPGD Manager — .gitignore raiz (monorepo: backend/ Django + frontend/ Svelte)
#
# Regra geral: ignore o que é GERADO, LOCAL ou SECRETO.
# Nunca ignore lockfile, migração ou schema de API — esses são o contrato do
# projeto e precisam ser iguais para todo mundo (ver notas no fim do arquivo).
# =============================================================================


# -----------------------------------------------------------------------------
# Segredos e configuração local  ← o mais importante deste arquivo
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.env.local

# Chaves, certificados, credenciais
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# Settings locais do Django (se alguém criar; o padrão do projeto é usar .env)
backend/config/settings/local.py


# -----------------------------------------------------------------------------
# Python / Django
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais (o uv cria .venv na raiz do backend)
.venv/
venv/
env/
ENV/

# Empacotamento
build/
dist/
*.egg-info/
.eggs/

# Django
db.sqlite3
db.sqlite3-journal
*.log
backend/staticfiles/          # saída do collectstatic
backend/media/                # uploads de usuário — NUNCA versionar
backend/static_root/

# Celery / worker (caso um módulo futuro precise)
celerybeat-schedule
celerybeat.pid


# -----------------------------------------------------------------------------
# Testes, lint e type check
# -----------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.hypothesis/


# -----------------------------------------------------------------------------
# Node / SvelteKit / Vite
# -----------------------------------------------------------------------------
node_modules/
.svelte-kit/
frontend/build/               # saída do adapter-static (vai pro Nginx, não pro git)
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Caches de ferramentas de front
.eslintcache
.stylelintcache
.prettiercache

# Saídas de outros adapters (caso alguém experimente)
.vercel/
.netlify/
.output/


# -----------------------------------------------------------------------------
# Docker e dados locais
# -----------------------------------------------------------------------------
docker-compose.override.yml   # ajustes da máquina de cada dev
.docker-data/
pgdata/
postgres-data/


# -----------------------------------------------------------------------------
# Banco: dumps e backups
# (backup de verdade vai pro Proxmox/offsite, não pro repositório)
# -----------------------------------------------------------------------------
*.sql
*.sql.gz
*.dump
*.bak
backups/
!backend/**/fixtures/*.sql    # exceção: fixture de teste versionada de propósito


# -----------------------------------------------------------------------------
# Editores e IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json        # config compartilhada do time pode ser versionada
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.\#*
\#*\#


# -----------------------------------------------------------------------------
# Sistema operacional
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini


# -----------------------------------------------------------------------------
# Ferramentas de IA / agentes
# (CLAUDE.md, AGENTS.md e docs/adr/ SÃO versionados — são a governança do projeto)
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/
.aider*
.cursorignore


# -----------------------------------------------------------------------------
# Diversos
# -----------------------------------------------------------------------------
logs/
tmp/
temp/
*.pid
*.seed
.cache/


# =============================================================================
# O QUE NÃO ESTÁ AQUI — DE PROPÓSITO. Não adicione sem discutir com o time.
#
#   uv.lock ............... versões exatas do backend. Sem ele, cada máquina
#                           instala uma coisa e "na minha máquina funciona".
#   package-lock.json ..... mesma coisa no frontend.
#   backend/apps/*/migrations/*.py ... migração é histórico do banco, é código.
#                           Só `__pycache__` dentro delas é ignorado (regra acima).
#   frontend/src/lib/api/schema.d.ts . é gerado por `make gen-api`, mas fica
#                           versionado: assim o CI roda `npm run check` sem
#                           subir o backend, e mudança de contrato de API
#                           aparece no diff do PR — que é onde ela deve ser vista.
#   .env.example .......... o modelo das variáveis, sem valores reais.
#                           Toda variável nova entra aqui no mesmo commit.
# =============================================================================