# Modelo do /opt/ppgm/.env de PRODUÇÃO. Copie para o servidor, preencha e
# `chmod 600`. O arquivo real NUNCA vai para o git.

# --- Django -------------------------------------------------------------------
# Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=ppgm.direito.ufmg.br
CSRF_TRUSTED_ORIGINS=https://ppgm.direito.ufmg.br
SITE_URL=https://ppgm.direito.ufmg.br

# --- Banco (o container do Postgres e o DATABASE_URL do backend usam estes) ---
POSTGRES_DB=ppgm
POSTGRES_USER=ppgm
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(24))"
# Só [0-9a-f]: vai dentro de uma URL, onde @ : / quebrariam o DATABASE_URL.
POSTGRES_PASSWORD=

# --- E-mail (ADR-009) --------------------------------------------------------
# Enquanto a infra não indicar o relay SMTP, fica o backend de console: o
# e-mail sai no log do backend e não para ninguém. Com o relay definido:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=25
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nao-responda@direito.ufmg.br

# --- Porta local em que o Nginx da stack atende o Caddy do host -------------
HTTP_PORT=8100

# --- Escritas pelo deploy.sh a cada publicação; não edite -------------------
# REGISTRY_IMAGE=
# IMAGE_TAG=
